{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchResults",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "verdict", "evidence"],
        "properties": {
          "topic": { "type": "string" },
          "verdict": {
            "type": "string",
            "enum": ["true", "false", "unclear"],
            "description": "true = the claim holds per current web sources. false = disproven. unclear = sources conflict or nothing authoritative found."
          },
          "evidence": {
            "type": "string",
            "description": "What was found, with the source URL. Required for true/false verdicts."
          }
        }
      }
    }
  }
}
